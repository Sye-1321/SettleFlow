{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.settleflow.invalid/events/payment.captured.v1.schema.json",
  "title": "payment.captured.v1",
  "description": "A manual Payment Intent was fully captured with an immutable Ledger posting.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^evt_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "eventType": {
      "const": "payment.captured.v1"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "merchantId": {
      "type": "string",
      "format": "uuid"
    },
    "paymentId": {
      "type": "string",
      "pattern": "^pi_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "capturedAmountMinor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "currency": {
      "enum": ["ETB", "USD"]
    },
    "availableOn": {
      "type": "string",
      "format": "date-time"
    },
    "ledgerTransactionId": {
      "type": "string",
      "pattern": "^ltx_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "requestId",
    "merchantId",
    "paymentId",
    "capturedAmountMinor",
    "currency",
    "availableOn",
    "ledgerTransactionId"
  ]
}
