generator client {
  provider               = "prisma-client"
  output                 = "../packages/infrastructure/src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
  engineType             = "client"
}

datasource db {
  provider = "postgresql"
}

enum MerchantStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")

  @@map("merchant_status")
}

enum ApiKeyStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
  REVOKED  @map("revoked")

  @@map("api_key_status")
}

enum PaymentCaptureMethod {
  MANUAL @map("manual")

  @@map("payment_capture_method")
}

enum PaymentStatus {
  CREATED            @map("created")
  AUTHORIZED         @map("authorized")
  CAPTURED           @map("captured")
  PARTIALLY_REFUNDED @map("partially_refunded")
  REFUNDED           @map("refunded")
  VOIDED             @map("voided")

  @@map("payment_status")
}

enum IdempotencyState {
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")

  @@map("idempotency_state")
}

enum LedgerEntrySide {
  DEBIT  @map("debit")
  CREDIT @map("credit")

  @@map("ledger_entry_side")
}

enum LedgerBusinessType {
  CAPTURE    @map("capture")
  REFUND     @map("refund")
  SETTLEMENT @map("settlement")
  REVERSAL   @map("reversal")

  @@map("ledger_business_type")
}

enum SettlementRunStatus {
  COMPLETED         @map("completed")
  NO_ELIGIBLE_ITEMS @map("no_eligible_items")

  @@map("settlement_run_status")
}

enum SettlementBatchStatus {
  BATCHED @map("batched")
  SETTLED @map("settled")

  @@map("settlement_batch_status")
}

enum SettlementAdjustmentStatus {
  PENDING @map("pending")
  BATCHED @map("batched")
  SETTLED @map("settled")

  @@map("settlement_adjustment_status")
}

enum ReconciliationImportStatus {
  STAGED    @map("staged")
  COMPLETED @map("completed")
  FAILED    @map("failed")

  @@map("reconciliation_import_status")
}

enum ReconciliationEventType {
  CAPTURE    @map("capture")
  REFUND     @map("refund")
  SETTLEMENT @map("settlement")
  ADJUSTMENT @map("adjustment")

  @@map("reconciliation_event_type")
}

enum ReconciliationProviderStatus {
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")

  @@map("reconciliation_provider_status")
}

enum ReconciliationResultBucket {
  MATCHED_EXACT          @map("matched_exact")
  PROVIDER_ONLY          @map("provider_only")
  PLATFORM_ONLY          @map("platform_only")
  CURRENCY_MISMATCH      @map("currency_mismatch")
  AMOUNT_MISMATCH        @map("amount_mismatch")
  STATUS_MISMATCH        @map("status_mismatch")
  DUPLICATE_PROVIDER_ROW @map("duplicate_provider_row")

  @@map("reconciliation_result_bucket")
}

enum WebhookEndpointStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("webhook_endpoint_status")
}

enum WebhookSecretLifecycle {
  CURRENT  @map("current")
  PREVIOUS @map("previous")
  RETIRED  @map("retired")

  @@map("webhook_secret_lifecycle")
}

enum WebhookDeliveryStatus {
  PENDING       @map("pending")
  RETRYING      @map("retrying")
  DELIVERED     @map("delivered")
  DEAD_LETTERED @map("dead_lettered")

  @@map("webhook_delivery_status")
}

enum WebhookDeliveryAttemptOutcome {
  DELIVERED             @map("delivered")
  RETRYABLE_FAILURE     @map("retryable_failure")
  NON_RETRYABLE_FAILURE @map("non_retryable_failure")
  UNKNOWN               @map("unknown")

  @@map("webhook_delivery_attempt_outcome")
}

model Merchant {
  id                    String                   @id @default(uuid()) @db.Uuid
  code                  String                   @unique(map: "merchants_code_key") @db.VarChar(64)
  status                MerchantStatus           @default(ACTIVE)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  apiKeys               ApiKey[]
  paymentIntents        PaymentIntent[]
  refunds               Refund[]
  ledgerAccounts        LedgerAccount[]
  ledgerTransactions    LedgerTransaction[]
  idempotencyKeys       IdempotencyKey[]
  outboxEvents          OutboxEvent[]
  webhookEndpoints      WebhookEndpoint[]
  webhookEvents         WebhookEventProjection[]
  auditEvents           AuditEvent[]
  settlementStreams     SettlementStream[]
  settlementPositions   SettlementPosition[]
  settlementRuns        SettlementRun[]
  settlementBatches     SettlementBatch[]
  settlementAdjustments SettlementAdjustment[]
  reconciliationImports ReconciliationImport[]

  @@map("merchants")
}

model ApiKey {
  id                    String                 @id @default(uuid()) @db.Uuid
  merchantId            String                 @map("merchant_id") @db.Uuid
  prefix                String                 @unique(map: "api_keys_prefix_key") @db.VarChar(32)
  secretHash            String                 @map("secret_hash") @db.Text
  scopes                String[]               @db.Text
  status                ApiKeyStatus           @default(ACTIVE)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt             DateTime?              @map("revoked_at") @db.Timestamptz(6)
  rotatedAt             DateTime?              @map("rotated_at") @db.Timestamptz(6)
  merchant              Merchant               @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "api_keys_merchant_id_fkey")
  auditEvents           AuditEvent[]
  settlementRuns        SettlementRun[]
  reconciliationImports ReconciliationImport[]

  @@index([merchantId, status], map: "api_keys_merchant_id_status_idx")
  @@map("api_keys")
}

model PaymentIntent {
  id                    String                 @id @default(uuid()) @db.Uuid
  publicId              String                 @unique(map: "payment_intents_public_id_key") @map("public_id") @db.VarChar(29)
  merchantId            String                 @map("merchant_id") @db.Uuid
  externalRef           String                 @map("external_ref") @db.VarChar(255)
  amountMinor           BigInt                 @map("amount_minor") @db.BigInt
  currency              String                 @db.Char(3)
  captureMethod         PaymentCaptureMethod   @map("capture_method")
  paymentStatus         PaymentStatus          @default(CREATED) @map("payment_status")
  capturedAmountMinor   BigInt                 @default(0) @map("captured_amount_minor") @db.BigInt
  refundedAmountMinor   BigInt                 @default(0) @map("refunded_amount_minor") @db.BigInt
  capturedAt            DateTime?              @map("captured_at") @db.Timestamptz(6)
  availableAt           DateTime?              @map("available_at") @db.Timestamptz(6)
  version               Int                    @default(0)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant              Merchant               @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "payment_intents_merchant_id_fkey")
  refunds               Refund[]
  settlementPosition    SettlementPosition?
  settlementBatchItem   SettlementBatchItem?
  settlementAdjustments SettlementAdjustment[]

  @@unique([merchantId, externalRef], map: "payment_intents_merchant_id_external_ref_key")
  @@unique([id, merchantId, currency], map: "payment_intents_id_merchant_id_currency_key")
  @@map("payment_intents")
}

model Refund {
  id                   String                @id @default(uuid()) @db.Uuid
  publicId             String                @unique(map: "refunds_public_id_key") @map("public_id") @db.VarChar(29)
  merchantId           String                @map("merchant_id") @db.Uuid
  paymentIntentId      String                @map("payment_intent_id") @db.Uuid
  externalRef          String                @map("external_ref") @db.VarChar(255)
  amountMinor          BigInt                @map("amount_minor") @db.BigInt
  currency             String                @db.Char(3)
  createdAt            DateTime              @map("created_at") @db.Timestamptz(6)
  merchant             Merchant              @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "refunds_merchant_id_fkey")
  paymentIntent        PaymentIntent         @relation(fields: [paymentIntentId, merchantId, currency], references: [id, merchantId, currency], onDelete: Restrict, onUpdate: Restrict, map: "refunds_payment_intent_id_merchant_id_currency_fkey")
  settlementAdjustment SettlementAdjustment?

  @@unique([merchantId, externalRef], map: "refunds_merchant_id_external_ref_key")
  @@index([merchantId, paymentIntentId, createdAt, id], map: "refunds_merchant_id_payment_intent_id_created_at_idx")
  @@map("refunds")
}

model LedgerAccount {
  id         String          @id @default(uuid()) @db.Uuid
  merchantId String          @map("merchant_id") @db.Uuid
  code       String          @db.VarChar(64)
  currency   String          @db.Char(3)
  normalSide LedgerEntrySide @map("normal_side")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  merchant   Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "ledger_accounts_merchant_id_fkey")
  entries    LedgerEntry[]

  @@unique([merchantId, code, currency], map: "ledger_accounts_merchant_id_code_currency_key")
  @@unique([id, merchantId, currency], map: "ledger_accounts_id_merchant_id_currency_key")
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id                String              @id @default(uuid()) @db.Uuid
  publicId          String              @unique(map: "ledger_transactions_public_id_key") @map("public_id") @db.VarChar(30)
  merchantId        String              @map("merchant_id") @db.Uuid
  currency          String              @db.Char(3)
  businessType      LedgerBusinessType  @map("business_type")
  businessReference String              @map("business_reference") @db.VarChar(255)
  reversalOfId      String?             @unique(map: "ledger_transactions_reversal_of_id_key") @map("reversal_of_id") @db.Uuid
  requestId         String              @map("request_id") @db.VarChar(128)
  occurredAt        DateTime            @map("occurred_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  postedAt          DateTime?           @map("posted_at") @db.Timestamptz(6)
  merchant          Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "ledger_transactions_merchant_id_fkey")
  reversalOf        LedgerTransaction?  @relation("LedgerTransactionReversal", fields: [reversalOfId, merchantId, currency], references: [id, merchantId, currency], onDelete: Restrict, onUpdate: Restrict, map: "ledger_transactions_reversal_of_id_merchant_id_currency_fkey")
  reversals         LedgerTransaction[] @relation("LedgerTransactionReversal")
  entries           LedgerEntry[]
  settlementBatch   SettlementBatch?

  @@unique([merchantId, businessType, businessReference], map: "ledger_transactions_merchant_id_business_type_reference_key")
  @@unique([id, merchantId, currency], map: "ledger_transactions_id_merchant_id_currency_key")
  @@map("ledger_transactions")
}

model SettlementStream {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  currency   String   @db.Char(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "settlement_streams_merchant_id_fkey")

  @@unique([merchantId, currency], map: "settlement_streams_merchant_id_currency_key")
  @@map("settlement_streams")
}

model SettlementFeePolicy {
  version      String   @db.VarChar(64)
  currency     String   @db.Char(3)
  flatFeeMinor BigInt   @map("flat_fee_minor") @db.BigInt
  basisPoints  Int      @map("basis_points")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([version, currency], map: "settlement_fee_policies_pkey")
  @@map("settlement_fee_policies")
}

model SettlementPosition {
  id                  String                 @id @default(uuid()) @db.Uuid
  paymentIntentId     String                 @unique(map: "settlement_positions_payment_intent_id_key") @map("payment_intent_id") @db.Uuid
  paymentPublicId     String                 @map("payment_public_id") @db.VarChar(29)
  merchantId          String                 @map("merchant_id") @db.Uuid
  currency            String                 @db.Char(3)
  capturedAmountMinor BigInt                 @map("captured_amount_minor") @db.BigInt
  refundedAmountMinor BigInt                 @map("refunded_amount_minor") @db.BigInt
  availableAt         DateTime               @map("available_at") @db.Timestamptz(6)
  capturedAt          DateTime               @map("captured_at") @db.Timestamptz(6)
  lastEventId         String                 @map("last_event_id") @db.VarChar(30)
  lastEventOccurredAt DateTime               @map("last_event_occurred_at") @db.Timestamptz(6)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant            Merchant               @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "settlement_positions_merchant_id_fkey")
  paymentIntent       PaymentIntent          @relation(fields: [paymentIntentId, merchantId, currency], references: [id, merchantId, currency], onDelete: Restrict, onUpdate: Restrict, map: "settlement_positions_payment_owner_fkey")
  batchItem           SettlementBatchItem?
  adjustments         SettlementAdjustment[]

  @@unique([id, merchantId, currency], map: "settlement_positions_id_merchant_id_currency_key")
  @@unique([paymentIntentId, merchantId, currency], map: "settlement_positions_payment_owner_key")
  @@index([merchantId, currency, availableAt, paymentIntentId], map: "settlement_positions_eligibility_idx")
  @@map("settlement_positions")
}

model SettlementRun {
  id                  String              @id @default(uuid()) @db.Uuid
  publicId            String              @unique(map: "settlement_runs_public_id_key") @map("public_id") @db.VarChar(30)
  merchantId          String              @map("merchant_id") @db.Uuid
  currency            String              @db.Char(3)
  cutoffDate          DateTime            @map("cutoff_date") @db.Date
  cutoffTimezone      String              @map("cutoff_timezone") @db.VarChar(64)
  cutoffAt            DateTime            @map("cutoff_at") @db.Timestamptz(6)
  status              SettlementRunStatus
  batchId             String?             @unique(map: "settlement_runs_batch_id_key") @map("batch_id") @db.Uuid
  moreEligible        Boolean             @default(false) @map("more_eligible")
  requestId           String              @map("request_id") @db.VarChar(128)
  requestedByApiKeyId String              @map("requested_by_api_key_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt         DateTime            @map("completed_at") @db.Timestamptz(6)
  merchant            Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "settlement_runs_merchant_id_fkey")
  requestedByApiKey   ApiKey              @relation(fields: [requestedByApiKeyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "settlement_runs_requested_by_api_key_id_fkey")
  batch               SettlementBatch?    @relation(fields: [batchId, merchantId, currency], references: [id, merchantId, currency], onDelete: Restrict, onUpdate: Restrict, map: "settlement_runs_batch_id_merchant_id_currency_fkey")

  @@unique([id, merchantId, currency], map: "settlement_runs_id_merchant_id_currency_key")
  @@index([merchantId, createdAt(sort: Desc), id(sort: Desc)], map: "settlement_runs_merchant_id_created_at_id_idx")
  @@map("settlement_runs")
}

model SettlementBatch {
  id                        String                 @id @default(uuid()) @db.Uuid
  publicId                  String                 @unique(map: "settlement_batches_public_id_key") @map("public_id") @db.VarChar(30)
  merchantId                String                 @map("merchant_id") @db.Uuid
  currency                  String                 @db.Char(3)
  cutoffDate                DateTime               @map("cutoff_date") @db.Date
  cutoffTimezone            String                 @map("cutoff_timezone") @db.VarChar(64)
  cutoffAt                  DateTime               @map("cutoff_at") @db.Timestamptz(6)
  status                    SettlementBatchStatus  @default(BATCHED)
  paymentGrossMinor         BigInt                 @map("payment_gross_minor") @db.BigInt
  adjustmentMinor           BigInt                 @map("adjustment_minor") @db.BigInt
  grossMinor                BigInt                 @map("gross_minor") @db.BigInt
  feeMinor                  BigInt                 @map("fee_minor") @db.BigInt
  netMinor                  BigInt                 @map("net_minor") @db.BigInt
  itemCount                 Int                    @map("item_count")
  adjustmentCount           Int                    @map("adjustment_count")
  ledgerTransactionId       String                 @unique(map: "settlement_batches_ledger_transaction_id_key") @map("ledger_transaction_id") @db.Uuid
  ledgerTransactionPublicId String                 @unique(map: "settlement_batches_ledger_transaction_public_id_key") @map("ledger_transaction_public_id") @db.VarChar(30)
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  settledAt                 DateTime?              @map("settled_at") @db.Timestamptz(6)
  merchant                  Merchant               @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "settlement_batches_merchant_id_fkey")
  ledgerTransaction         LedgerTransaction      @relation(fields: [ledgerTransactionId, merchantId, currency], references: [id, merchantId, currency], onDelete: Restrict, onUpdate: Restrict, map: "settlement_batches_ledger_owner_fkey")
  runs                      SettlementRun[]
  items                     SettlementBatchItem[]
  adjustments               SettlementAdjustment[]

  @@unique([id, merchantId, currency], map: "settlement_batches_id_merchant_id_currency_key")
  @@unique([ledgerTransactionId, merchantId, currency], map: "settlement_batches_ledger_owner_key")
  @@index([merchantId, createdAt(sort: Desc), id(sort: Desc)], map: "settlement_batches_merchant_id_created_at_id_idx")
  @@map("settlement_batches")
}

model SettlementBatchItem {
  id                   String                 @id @default(uuid()) @db.Uuid
  batchId              String                 @map("batch_id") @db.Uuid
  settlementPositionId String                 @unique(map: "settlement_batch_items_position_id_key") @map("settlement_position_id") @db.Uuid
  paymentIntentId      String                 @unique(map: "settlement_batch_items_payment_intent_id_key") @map("payment_intent_id") @db.Uuid
  merchantId           String                 @map("merchant_id") @db.Uuid
  currency             String                 @db.Char(3)
  capturedAmountMinor  BigInt                 @map("captured_amount_minor") @db.BigInt
  refundedAmountMinor  BigInt                 @map("refunded_amount_minor") @db.BigInt
  grossMinor           BigInt                 @map("gross_minor") @db.BigInt
  feePolicyVersion     String                 @map("fee_policy_version") @db.VarChar(64)
  flatFeeMinor         BigInt                 @map("flat_fee_minor") @db.BigInt
  basisPoints          Int                    @map("basis_points")
  feeMinor             BigInt                 @map("fee_minor") @db.BigInt
  netMinor             BigInt                 @map("net_minor") @db.BigInt
  availableAt          DateTime               @map("available_at") @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  batch                SettlementBatch        @relation(fields: [batchId, merchantId, currency], references: [id, merchantId, currency], onDelete: Restrict, onUpdate: Restrict, map: "settlement_batch_items_batch_id_merchant_id_currency_fkey")
  position             SettlementPosition     @relation(fields: [settlementPositionId, merchantId, currency], references: [id, merchantId, currency], onDelete: Restrict, onUpdate: Restrict, map: "settlement_batch_items_position_id_merchant_id_currency_fkey")
  paymentIntent        PaymentIntent          @relation(fields: [paymentIntentId, merchantId, currency], references: [id, merchantId, currency], onDelete: Restrict, onUpdate: Restrict, map: "settlement_batch_items_payment_owner_fkey")
  adjustments          SettlementAdjustment[]

  @@unique([id, merchantId, currency], map: "settlement_batch_items_id_merchant_id_currency_key")
  @@unique([settlementPositionId, merchantId, currency], map: "settlement_batch_items_position_owner_key")
  @@unique([paymentIntentId, merchantId, currency], map: "settlement_batch_items_payment_owner_key")
  @@index([batchId, availableAt, paymentIntentId], map: "settlement_batch_items_batch_order_idx")
  @@map("settlement_batch_items")
}

model SettlementAdjustment {
  id                   String                     @id @default(uuid()) @db.Uuid
  publicId             String                     @unique(map: "settlement_adjustments_public_id_key") @map("public_id") @db.VarChar(30)
  merchantId           String                     @map("merchant_id") @db.Uuid
  currency             String                     @db.Char(3)
  paymentIntentId      String                     @map("payment_intent_id") @db.Uuid
  settlementPositionId String                     @map("settlement_position_id") @db.Uuid
  originalBatchItemId  String                     @map("original_batch_item_id") @db.Uuid
  refundId             String                     @unique(map: "settlement_adjustments_refund_id_key") @map("refund_id") @db.Uuid
  refundPublicId       String                     @map("refund_public_id") @db.VarChar(29)
  amountMinor          BigInt                     @map("amount_minor") @db.BigInt
  status               SettlementAdjustmentStatus @default(PENDING)
  batchId              String?                    @map("batch_id") @db.Uuid
  sourceEventId        String                     @unique(map: "settlement_adjustments_source_event_id_key") @map("source_event_id") @db.VarChar(30)
  occurredAt           DateTime                   @map("occurred_at") @db.Timestamptz(6)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  settledAt            DateTime?                  @map("settled_at") @db.Timestamptz(6)
  merchant             Merchant                   @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "settlement_adjustments_merchant_id_fkey")
  paymentIntent        PaymentIntent              @relation(fields: [paymentIntentId, merchantId, currency], references: [id, merchantId, currency], onDelete: Restrict, onUpdate: Restrict, map: "settlement_adjustments_payment_owner_fkey")
  position             SettlementPosition         @relation(fields: [settlementPositionId, merchantId, currency], references: [id, merchantId, currency], onDelete: Restrict, onUpdate: Restrict, map: "settlement_adjustments_position_id_merchant_id_currency_fkey")
  originalBatchItem    SettlementBatchItem        @relation(fields: [originalBatchItemId, merchantId, currency], references: [id, merchantId, currency], onDelete: Restrict, onUpdate: Restrict, map: "settlement_adjustments_original_item_owner_fkey")
  refund               Refund                     @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "settlement_adjustments_refund_id_fkey")
  batch                SettlementBatch?           @relation(fields: [batchId, merchantId, currency], references: [id, merchantId, currency], onDelete: Restrict, onUpdate: Restrict, map: "settlement_adjustments_batch_id_merchant_id_currency_fkey")

  @@index([merchantId, currency, status, occurredAt, id], map: "settlement_adjustments_pending_idx")
  @@map("settlement_adjustments")
}

model ReconciliationImport {
  id                  String                      @id @default(uuid()) @db.Uuid
  publicId            String                      @unique(map: "reconciliation_imports_public_id_key") @map("public_id") @db.VarChar(30)
  merchantId          String                      @map("merchant_id") @db.Uuid
  contentSha256       Bytes                       @map("content_sha256") @db.ByteA
  byteCount           Int                         @map("byte_count")
  rowCount            Int                         @map("row_count")
  periodStart         DateTime                    @map("period_start") @db.Timestamptz(6)
  periodEnd           DateTime                    @map("period_end") @db.Timestamptz(6)
  status              ReconciliationImportStatus  @default(STAGED)
  requestId           String                      @map("request_id") @db.VarChar(128)
  requestedByApiKeyId String                      @map("requested_by_api_key_id") @db.Uuid
  failureCode         String?                     @map("failure_code") @db.VarChar(64)
  failureRowNumber    Int?                        @map("failure_row_number")
  rawRowsExpireAt     DateTime                    @map("raw_rows_expire_at") @db.Timestamptz(6)
