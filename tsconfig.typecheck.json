{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true,
    "paths": {
      "@settleflow/infrastructure": ["./packages/infrastructure/src/index.ts"],
      "@settleflow/merchant-access": ["./packages/modules/merchant-access/src/index.ts"],
      "@settleflow/idempotency": ["./packages/modules/idempotency/src/index.ts"],
      "@settleflow/eventing": ["./packages/modules/eventing/src/index.ts"],
      "@settleflow/payments": ["./packages/modules/payments/src/index.ts"],
      "@settleflow/operations": ["./packages/modules/operations/src/index.ts"],
      "@settleflow/webhooks": ["./packages/modules/webhooks/src/index.ts"]
    },
    "types": ["jest", "node"]
  },
  "exclude": ["apps/**/dist/**", "packages/**/dist/**"],
  "include": ["apps/**/*.ts", "packages/**/*.ts", "test/**/*.ts", "prisma.config.mts"]
}
