# Safe local defaults only. Copy to apps/api/.env to override them.
NODE_ENV=development
SETTLEFLOW_DEPLOYMENT_MODE=host
API_HOST=127.0.0.1
API_PORT=3000
RELEASE_VERSION=0.0.0-dev
RELEASE_COMMIT=local
INTERNAL_TELEMETRY_ENABLED=true
INTERNAL_TELEMETRY_HOST=127.0.0.1
INTERNAL_TELEMETRY_PORT=9464
OTEL_TRACING_ENABLED=false
OTEL_TRACE_SAMPLE_RATIO=0.1
OTEL_TRACE_EXPORT_TIMEOUT_MS=5000
OTEL_DEMO_TRACE_MODE=false
# Required only when OTEL_TRACING_ENABLED=true:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
DATABASE_URL=postgresql://settleflow_app:settleflow_app_local_only@127.0.0.1:5432/settleflow
RABBITMQ_URL=amqp://settleflow:settleflow_local_only@127.0.0.1:5672/settleflow
DEPENDENCY_READINESS_TIMEOUT_MS=2000
IDEMPOTENCY_LEASE_MS=30000
IDEMPOTENCY_LOCK_TIMEOUT_MS=5000
IDEMPOTENCY_REPLAY_TTL_HOURS=168
IDEMPOTENCY_STATEMENT_TIMEOUT_MS=10000
WEBHOOK_ENDPOINT_LOCK_TIMEOUT_MS=5000
WEBHOOK_ENDPOINT_STATEMENT_TIMEOUT_MS=10000
WEBHOOK_URL_POLICY_MODE=development
WEBHOOK_DEVELOPMENT_ALLOWED_ORIGINS=["http://127.0.0.1:8080"]
WEBHOOK_KEYRING_PROVIDER=local
WEBHOOK_LOCAL_ACTIVE_KEY_ID=local-v1
# Generate an ignored local value; never commit it:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
WEBHOOK_LOCAL_KEYS_JSON={"local-v1":"replace-with-32-byte-base64url-key"}
