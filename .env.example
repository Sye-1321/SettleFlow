# Synthetic local-development values only. Never reuse them outside this project.
POSTGRES_DB=settleflow
POSTGRES_USER=settleflow
POSTGRES_PASSWORD=settleflow_local_only
POSTGRES_APP_USER=settleflow_app
POSTGRES_APP_PASSWORD=settleflow_app_local_only
POSTGRES_PORT=5432
MIGRATION_DATABASE_URL=postgresql://settleflow:settleflow_local_only@127.0.0.1:5432/settleflow
DATABASE_URL=postgresql://settleflow_app:settleflow_app_local_only@127.0.0.1:5432/settleflow

RABBITMQ_DEFAULT_USER=settleflow
RABBITMQ_DEFAULT_PASS=settleflow_local_only
RABBITMQ_DEFAULT_VHOST=settleflow
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Optional loopback-only local telemetry profile.
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
