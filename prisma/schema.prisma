generator client {
  provider               = "prisma-client"
  output                 = "../packages/infrastructure/src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
  engineType             = "client"
}

datasource db {
  provider = "postgresql"
}

enum MerchantStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")

  @@map("merchant_status")
}

enum ApiKeyStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
  REVOKED  @map("revoked")

  @@map("api_key_status")
}

enum PaymentCaptureMethod {
  MANUAL @map("manual")

  @@map("payment_capture_method")
}

enum PaymentStatus {
  CREATED            @map("created")
  AUTHORIZED         @map("authorized")
  CAPTURED           @map("captured")
  PARTIALLY_REFUNDED @map("partially_refunded")
  REFUNDED           @map("refunded")
  VOIDED             @map("voided")

  @@map("payment_status")
}

enum IdempotencyState {
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")

  @@map("idempotency_state")
}

enum WebhookEndpointStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("webhook_endpoint_status")
}

enum WebhookSecretLifecycle {
  CURRENT  @map("current")
  PREVIOUS @map("previous")
  RETIRED  @map("retired")

  @@map("webhook_secret_lifecycle")
}

enum WebhookDeliveryStatus {
  PENDING @map("pending")

  @@map("webhook_delivery_status")
}

model Merchant {
  id               String                   @id @default(uuid()) @db.Uuid
  code             String                   @unique(map: "merchants_code_key") @db.VarChar(64)
  status           MerchantStatus           @default(ACTIVE)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  apiKeys          ApiKey[]
  paymentIntents   PaymentIntent[]
  idempotencyKeys  IdempotencyKey[]
  outboxEvents     OutboxEvent[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents    WebhookEventProjection[]
  auditEvents      AuditEvent[]

  @@map("merchants")
}

model ApiKey {
  id          String       @id @default(uuid()) @db.Uuid
  merchantId  String       @map("merchant_id") @db.Uuid
  prefix      String       @unique(map: "api_keys_prefix_key") @db.VarChar(32)
  secretHash  String       @map("secret_hash") @db.Text
  scopes      String[]     @db.Text
  status      ApiKeyStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(6)
  rotatedAt   DateTime?    @map("rotated_at") @db.Timestamptz(6)
  merchant    Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "api_keys_merchant_id_fkey")
  auditEvents AuditEvent[]

  @@index([merchantId, status], map: "api_keys_merchant_id_status_idx")
  @@map("api_keys")
}

model PaymentIntent {
  id                  String               @id @default(uuid()) @db.Uuid
  publicId            String               @unique(map: "payment_intents_public_id_key") @map("public_id") @db.VarChar(29)
  merchantId          String               @map("merchant_id") @db.Uuid
  externalRef         String               @map("external_ref") @db.VarChar(255)
  amountMinor         BigInt               @map("amount_minor") @db.BigInt
  currency            String               @db.Char(3)
  captureMethod       PaymentCaptureMethod @map("capture_method")
  paymentStatus       PaymentStatus        @default(CREATED) @map("payment_status")
  capturedAmountMinor BigInt               @default(0) @map("captured_amount_minor") @db.BigInt
  refundedAmountMinor BigInt               @default(0) @map("refunded_amount_minor") @db.BigInt
  version             Int                  @default(0)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant            Merchant             @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "payment_intents_merchant_id_fkey")

  @@unique([merchantId, externalRef], map: "payment_intents_merchant_id_external_ref_key")
  @@map("payment_intents")
}

model IdempotencyKey {
  id                  String           @id @default(uuid()) @db.Uuid
  merchantId          String           @map("merchant_id") @db.Uuid
  httpMethod          String           @map("http_method") @db.VarChar(8)
  normalizedRoute     String           @map("normalized_route") @db.VarChar(255)
  keyHash             Bytes            @map("key_hash") @db.ByteA
  requestHash         Bytes            @map("request_hash") @db.ByteA
  state               IdempotencyState
  ownerToken          String?          @map("owner_token") @db.Uuid
  leaseExpiresAt      DateTime?        @map("lease_expires_at") @db.Timestamptz(6)
  responseStatus      Int?             @map("response_status")
  responseContentType String?          @map("response_content_type") @db.VarChar(128)
  responseHeaders     Json?            @map("response_headers") @db.JsonB
  responseBody        Json?            @map("response_body") @db.JsonB
  resultReference     String?          @map("result_reference") @db.VarChar(255)
  completedAt         DateTime?        @map("completed_at") @db.Timestamptz(6)
  responseExpiresAt   DateTime?        @map("response_expires_at") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant            Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "idempotency_keys_merchant_id_fkey")

  @@unique([merchantId, httpMethod, normalizedRoute, keyHash], map: "idempotency_keys_scope_key")
  @@map("idempotency_keys")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  eventId        String    @unique(map: "outbox_events_event_id_key") @map("event_id") @db.VarChar(30)
  eventType      String    @map("event_type") @db.VarChar(128)
  merchantId     String    @map("merchant_id") @db.Uuid
  aggregateType  String    @map("aggregate_type") @db.VarChar(64)
  aggregateId    String    @map("aggregate_id") @db.VarChar(255)
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(6)
  requestId      String    @map("request_id") @db.VarChar(128)
  payload        Json      @db.JsonB
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  attemptCount   Int       @default(0) @map("attempt_count")
  lockedBy       String?   @map("locked_by") @db.VarChar(128)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant       Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "outbox_events_merchant_id_fkey")

  @@map("outbox_events")
}

model InboxMessage {
  consumerName  String   @map("consumer_name") @db.VarChar(128)
  messageId     String   @map("message_id") @db.VarChar(30)
  eventType     String   @map("event_type") @db.VarChar(128)
  schemaVersion Int      @map("schema_version")
  payloadSha256 Bytes    @map("payload_sha256") @db.ByteA
  correlationId String   @map("correlation_id") @db.VarChar(128)
  receivedAt    DateTime @map("received_at") @db.Timestamptz(6)
  completedAt   DateTime @map("completed_at") @db.Timestamptz(6)

  @@id([consumerName, messageId], map: "inbox_messages_pkey")
  @@index([completedAt], map: "inbox_messages_completed_at_idx")
  @@map("inbox_messages")
}

model WebhookEndpoint {
  id            String                        @id @default(uuid()) @db.Uuid
  publicId      String                        @unique(map: "webhook_endpoints_public_id_key") @map("public_id") @db.VarChar(30)
  merchantId    String                        @map("merchant_id") @db.Uuid
  normalizedUrl String                        @map("normalized_url") @db.Text
  status        WebhookEndpointStatus         @default(ACTIVE)
  version       Int                           @default(0)
  createdAt     DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant      Merchant                      @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "webhook_endpoints_merchant_id_fkey")
  subscriptions WebhookEndpointSubscription[]
  secrets       WebhookEndpointSecret[]
  deliveries    WebhookDelivery[]

  @@unique([merchantId, normalizedUrl], map: "webhook_endpoints_merchant_id_normalized_url_key")
  @@unique([id, merchantId], map: "webhook_endpoints_id_merchant_id_key")
  @@index([merchantId, publicId(sort: Desc)], map: "webhook_endpoints_merchant_id_public_id_idx")
  @@index([merchantId, status, id], map: "webhook_endpoints_merchant_id_status_id_idx")
  @@map("webhook_endpoints")
}

model WebhookEndpointSubscription {
  endpointId String          @map("endpoint_id") @db.Uuid
  eventType  String          @map("event_type") @db.VarChar(128)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "webhook_endpoint_subscriptions_endpoint_id_fkey")

  @@id([endpointId, eventType], map: "webhook_endpoint_subscriptions_pkey")
  @@map("webhook_endpoint_subscriptions")
}

model WebhookEndpointSecret {
  id                String                 @id @default(uuid()) @db.Uuid
  endpointId        String                 @map("endpoint_id") @db.Uuid
  secretVersion     Int                    @map("secret_version")
  lifecycle         WebhookSecretLifecycle
  algorithm         String                 @db.VarChar(32)
  encryptionKeyId   String                 @map("encryption_key_id") @db.VarChar(64)
  nonce             Bytes                  @db.ByteA
  ciphertext        Bytes                  @db.ByteA
  authenticationTag Bytes                  @map("authentication_tag") @db.ByteA
  overlapExpiresAt  DateTime?              @map("overlap_expires_at") @db.Timestamptz(6)
  retiredAt         DateTime?              @map("retired_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  endpoint          WebhookEndpoint        @relation(fields: [endpointId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "webhook_endpoint_secrets_endpoint_id_fkey")

  @@unique([endpointId, secretVersion], map: "webhook_endpoint_secrets_endpoint_id_secret_version_key")
  @@map("webhook_endpoint_secrets")
}

model WebhookEventProjection {
  eventId       String            @id(map: "webhook_event_projections_pkey") @map("event_id") @db.VarChar(30)
  eventType     String            @map("event_type") @db.VarChar(128)
  schemaVersion Int               @map("schema_version")
  merchantId    String            @map("merchant_id") @db.Uuid
  paymentId     String            @map("payment_id") @db.VarChar(29)
  occurredAt    DateTime          @map("occurred_at") @db.Timestamptz(6)
  requestId     String            @map("request_id") @db.VarChar(128)
  amountMinor   BigInt            @map("amount_minor") @db.BigInt
  currency      String            @db.Char(3)
  paymentStatus String            @map("payment_status") @db.VarChar(32)
  payloadBytes  Bytes             @map("payload_bytes") @db.ByteA
  payloadSha256 Bytes             @map("payload_sha256") @db.ByteA
  projectedAt   DateTime          @map("projected_at") @db.Timestamptz(6)
  merchant      Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "webhook_event_projections_merchant_id_fkey")
  deliveries    WebhookDelivery[]

  @@unique([eventId, merchantId], map: "webhook_event_projections_event_id_merchant_id_key")
  @@index([merchantId, projectedAt], map: "webhook_event_projections_merchant_id_projected_at_idx")
  @@map("webhook_event_projections")
}

model WebhookDelivery {
  id            String                 @id @default(uuid()) @db.Uuid
  publicId      String                 @unique(map: "webhook_deliveries_public_id_key") @map("public_id") @db.VarChar(30)
  merchantId    String                 @map("merchant_id") @db.Uuid
  endpointId    String                 @map("endpoint_id") @db.Uuid
  eventId       String                 @map("event_id") @db.VarChar(30)
  status        WebhookDeliveryStatus  @default(PENDING)
  attemptCount  Int                    @default(0) @map("attempt_count")
  nextAttemptAt DateTime               @map("next_attempt_at") @db.Timestamptz(6)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  endpoint      WebhookEndpoint        @relation(fields: [endpointId, merchantId], references: [id, merchantId], onDelete: Restrict, onUpdate: Cascade, map: "webhook_deliveries_endpoint_id_merchant_id_fkey")
  event         WebhookEventProjection @relation(fields: [eventId, merchantId], references: [eventId, merchantId], onDelete: Restrict, onUpdate: Cascade, map: "webhook_deliveries_event_id_merchant_id_fkey")

  @@unique([endpointId, eventId], map: "webhook_deliveries_endpoint_id_event_id_key")
  @@map("webhook_deliveries")
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  merchantId    String   @map("merchant_id") @db.Uuid
  actorType     String   @map("actor_type") @db.VarChar(32)
  actorApiKeyId String   @map("actor_api_key_id") @db.Uuid
  action        String   @db.VarChar(128)
  targetType    String   @map("target_type") @db.VarChar(64)
  targetId      String   @map("target_id") @db.VarChar(30)
  reason        String   @db.VarChar(64)
  requestId     String   @map("request_id") @db.VarChar(128)
  details       Json     @db.JsonB
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "audit_events_merchant_id_fkey")
  actorApiKey   ApiKey   @relation(fields: [actorApiKeyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "audit_events_actor_api_key_id_fkey")

  @@index([merchantId, occurredAt(sort: Desc), id(sort: Desc)], map: "audit_events_merchant_id_occurred_at_id_idx")
  @@index([targetType, targetId, occurredAt(sort: Desc), id(sort: Desc)], map: "audit_events_target_occurred_at_id_idx")
  @@map("audit_events")
}
