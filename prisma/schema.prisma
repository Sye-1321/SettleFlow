generator client {
  provider               = "prisma-client"
  output                 = "../packages/infrastructure/src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
  engineType             = "client"
}

datasource db {
  provider = "postgresql"
}

