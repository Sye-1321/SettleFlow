generator client {
  provider               = "prisma-client"
  output                 = "../packages/infrastructure/src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
  engineType             = "client"
}

datasource db {
  provider = "postgresql"
}

enum MerchantStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")

  @@map("merchant_status")
}

enum ApiKeyStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
  REVOKED  @map("revoked")

  @@map("api_key_status")
}

model Merchant {
  id        String         @id @default(uuid()) @db.Uuid
  code      String         @unique(map: "merchants_code_key") @db.VarChar(64)
  status    MerchantStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  apiKeys   ApiKey[]

  @@map("merchants")
}

model ApiKey {
  id         String       @id @default(uuid()) @db.Uuid
  merchantId String       @map("merchant_id") @db.Uuid
  prefix     String       @unique(map: "api_keys_prefix_key") @db.VarChar(32)
  secretHash String       @map("secret_hash") @db.Text
  scopes     String[]     @db.Text
  status     ApiKeyStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(6)
  rotatedAt  DateTime?    @map("rotated_at") @db.Timestamptz(6)
  merchant   Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "api_keys_merchant_id_fkey")

  @@index([merchantId, status], map: "api_keys_merchant_id_status_idx")
  @@map("api_keys")
}
